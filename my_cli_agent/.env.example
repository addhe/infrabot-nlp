# -------------------------
# Google Gemini Configuration
# -------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your_google_api_key_here"

# The model to use. "gemini-pro" is a good default.
GEMINI_MODEL_ID="gemini-pro"

# -------------------------
# Zen MCP Server (Optional)
# -------------------------
# The full URL to your running zen-mcp-server instance.
# If this is not set, the 'call_mcp_server' tool will be disabled.
MCP_SERVER_URL="http://127.0.0.1:8000"

# ----------------------------------
# Sequential Thinking MCP (Optional)
# ----------------------------------
# URL for the sequential-thinking-mcp server.
SEQ_THINKING_MCP_SERVER_URL="http://1227.0.0.1:8001"

# -------------------------
# Playwright MCP (Optional)
# -------------------------
# URL for the playwright-mcp server.
PLAYWRIGHT_MCP_SERVER_URL="http://127.0.0.1:8931"

# -------------------------
# gcloud MCP (Optional)
# -------------------------
# URL for the gcloud-mcp server.
GCLOUD_MCP_SERVER_URL="http://127.0.0.1:8932"
